@model IEnumerable<Tourism_Project.Models.Hotel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-3" dir="rtl">
    <h3>قائمة الفنادق</h3>
    <a asp-action="CreateHotel" class="btn btn-success">
        + إضافة فندق
    </a>
</div>
<table class="table" border="2" dir="rtl">
    <tr>
        <th>اسم الفندق</th>
        <th>الوصف</th>
        <th>الصورة</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Description)</td>
            <td>
                <img src="~/files/images/@item.ImageUrl"
                     width="70" height="70" alt="Hotel Image" />
            </td>
            <td>
                <div class="d-flex gap-2">
                    @Html.ActionLink("حذف الفندق", "DeleteHotel",
                    new { id = item.Id },
                                new { @class = "btn btn-danger btn-sm" })

                <a asp-action="GetHotelRooms"
                   asp-route-hotelId="@item.Id"
                   class="btn btn-primary btn-sm">
                    🛏 إدارة الغرف
                </a>
            </div>
        </td>
    </tr>
        }
</table>